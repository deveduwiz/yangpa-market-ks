DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=1234
DB_NAME=yangpa
DIALECT=postgres
DB_SSL=false
JWT_SECRET=your_jwt_secret
SALT_ROUNDS=10

# Storage Configuration
# STORAGE_TYPE: 'local' or 'azure'
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=files

# Azure Blob Storage (required if STORAGE_TYPE=azure)
AZURE_STORAGE_CONNECTION_STRING=your_azure_storage_connection_string
AZURE_STORAGE_CONTAINER_NAME=images